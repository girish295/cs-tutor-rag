# ---------------------------------------------------------------------------
# Groq API key — the only thing you need to configure.
# Get one free at https://console.groq.com/keys
#
# Leave it unset to run in DEMO MODE: the app still works, with real retrieval
# and real interactive widgets, but replies are assembled from the retrieved
# passages instead of written by a model, and images are not analysed.
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Optional model overrides.
#
# Groq retires and renames models, so these are configurable rather than
# hardcoded. Run `npm run models` with a key set to list what your account can
# actually reach, then set these if the defaults have moved.
#
# Defaults: GROQ_TEXT_MODEL=openai/gpt-oss-120b
#           GROQ_VISION_MODEL=qwen/qwen3.8-27b
# ---------------------------------------------------------------------------
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
