{
  "name": "cs-tutor-multimodal-rag",
  "version": "1.0.0",
  "private": true,
  "description": "Multimodal RAG chatbot for CS & programming fundamentals — text + image input, hybrid retrieval, tool calling and generative UI.",
  "scripts": {
    "corpus": "node scripts/build-corpus.mjs",
