    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/build-corpus.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "models": "node scripts/list-models.mjs"
  },
  "dependencies": {
    "@ai-sdk/groq": "4.0.50",
